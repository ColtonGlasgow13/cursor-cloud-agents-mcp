# Pass this file with --env-file-path, or copy it to .env in the server's working directory.
# Node's native parser accepts quotes but does not expand $VARIABLES or run shell expressions.
# Process environment values take precedence over this file, including empty values.
# CURSOR_API_KEY accepts a Cursor user API key or service account API key.
# The server uses only CURSOR_API_KEY, CURSOR_API_BASE, and CURSOR_MCP_LOG_LEVEL from this file.
CURSOR_API_KEY='<YOUR_CURSOR_API_KEY>'

# Optional overrides (defaults shown):
# CURSOR_API_BASE=https://api.cursor.com
# CURSOR_MCP_LOG_LEVEL=warn
